# Use your own Evervault sandbox app. Keep all actual values in .env.
EVERVAULT_TEAM_ID=<your-team-id>
EVERVAULT_APP_ID=<your-sandbox-app-id>
EVERVAULT_API_KEY=<your-server-api-key>
BROWSERBASE_API_KEY=<your-browserbase-api-key>
# npm run setup prints this assignment for you to copy into .env.
BROWSERBASE_CA_CERTIFICATE_ID=
# Exact hostname of YOUR route-limited HTTPS merchant endpoint (no scheme/path).
CARD_TARGET_HOST=cards.example.com
PORT=4173
