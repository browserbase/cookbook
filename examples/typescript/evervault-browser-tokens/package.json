{
  "name": "evervault-browser-tokens-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@browserbasehq/sdk": "2.18.0",
    "@browserbasehq/stagehand": "4.1.0",
    "dotenv": "16.6.1",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
