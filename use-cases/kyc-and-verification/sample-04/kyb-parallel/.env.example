BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# No LLM provider key needed — Stagehand's default API mode (disableAPI: false)
# routes act/extract/observe through Browserbase's managed model gateway, which
# handles model auth on the server. If you want to bypass the gateway and use a
# provider directly, set disableAPI: true in kyb-parallel.ts and supply the
# corresponding key here (e.g. GOOGLE_GENERATIVE_AI_API_KEY=...).
