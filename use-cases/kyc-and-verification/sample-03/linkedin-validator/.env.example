# Browserbase credentials
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# AI Model - uses Anthropic Claude by default
ANTHROPIC_API_KEY=

# Optional: proxy geolocation (default: US)
PROXY_COUNTRY=US

# Optional: Browserbase persistent context for logged-in LinkedIn sessions
# Create one by running: npm run login
# After logging in manually, the context ID is saved here for reuse
BROWSERBASE_CONTEXT_ID=
