# Copy to `.env` (gitignored), set the target API base URL, and fill in one auth option.
AP_API_BASE_URL=https://ap.example.invalid

# ---- Option A: Agent Key (Developer > Agents tab) -------------------------
# Paste the agent key's SECRET token value (shown once when you create the key).
# Used directly as `Authorization: Bearer <token>`. We verify it with a read first.
AP_ACCESS_TOKEN=

# ---- Option B: Client Credentials App (Developer > Apps tab) --------------
# AP_CLIENT_ID=ap_platform_id_...
# AP_CLIENT_SECRET=ap_platform_sec_...

# ---- Common ----------------------------------------------------------------
AP_ENV=sandbox
AP_BILL_MODE=draft   # "draft" = provisional/never paid (safe). "bill" = full submitted bill.
# Required only when AP_BILL_MODE=bill. Keeps accidental submitted-bill runs from happening in demos.
AP_ALLOW_SUBMIT_BILL=false
