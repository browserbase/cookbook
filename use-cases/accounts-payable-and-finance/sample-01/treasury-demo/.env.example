# ─── Browserbase (required for cloud execution) ─────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# ─── LLM Model Key (required) ───────────────────────────────────────
# Stagehand uses an LLM to understand pages and take actions.
# Provide your Google Gemini, OpenAI, or Anthropic key:
MODEL_API_KEY=
# GOOGLE_API_KEY=your_google_api_key          # Alternative for Gemini
# OPENAI_API_KEY=your_openai_api_key          # Alternative for GPT-4o
# ANTHROPIC_API_KEY=your_anthropic_api_key    # Alternative for Claude

# ─── Mock Portal URLs (defaults to localhost:3000) ──────────────────
# BANK_PORTAL_URL=http://localhost:3000/bank-portal.html
# TREASURY_PORTAL_URL=http://localhost:3000/treasury-portal.html

# ─── Bank Credentials (for mock portal, defaults shown) ─────────────
# BANK_USERNAME=sample_org_treasury
# BANK_PASSWORD=demo2024
