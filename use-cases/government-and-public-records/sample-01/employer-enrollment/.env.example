# Copy to .env and fill in.

# AgentMail — sign up at https://console.agentmail.to
AGENTMAIL_API_KEY=

# Browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Anthropic — used by the autobrowse inner agent only
ANTHROPIC_API_KEY=

# Explicit opt-in for creating a real EDD Employer Services Online account.
# Keep false for setup, smoke checks, and typechecks. Set true only when you
# intentionally want the demo to submit the enrollment form and create an inert
# account record.
CA_EDD_ALLOW_ACCOUNT_CREATION=false

# Plausible-but-fake PII for EDD enrollment.
# A real Employer Services Online account is created on success.
# EDD does not validate the EIN or business name at enrollment time — those
# checks happen at the per-service step, which this demo does not reach.
TEST_FIRST_NAME=Test
TEST_LAST_NAME=Agent
TEST_BUSINESS_NAME="Browserbase Demo Co."
TEST_EIN=900123456
# Phone MUST include dashes (xxx-xxx-xxxx); raw digits trigger a validation
# error that ALSO silently clears the password fields on the enrollment form.
TEST_PHONE=415-555-0199
TEST_ADDRESS_LINE1="123 Market Street"
TEST_CITY="San Francisco"
TEST_STATE=CA
TEST_ZIP=94105

# Optional absolute path to the separately installed, compatible evaluator.
# CA_EDD_EVALUATOR_PATH=/your/workspace/browserbase-skills/skills/autobrowse/scripts/evaluate.mjs
