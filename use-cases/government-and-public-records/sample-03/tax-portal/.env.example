# Resend (for sending OTP emails)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev  # Use your verified domain or Resend's test domain

# Your email (where OTP will be sent)
USER_EMAIL=

BROWSERBASE_PROJECT_ID=**
BROWSERBASE_API_KEY=
MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Server defaults to loopback. Change HOST only for a controlled deployment.
HOST=127.0.0.1
PORT=3000

# Canonical server origin and remote automation URL; the proxy must preserve Host.
# Remote automation requires an origin reachable by Browserbase, not localhost.
PORTAL_URL=

# Created by npm run setup-gmail, after login and session termination/sync.
BROWSERBASE_CONTEXT_ID=
