BROWSERBASE_API_KEY=

# Use Browserbase by default. Set to false for local Stagehand smoke tests.
USE_BROWSERBASE=true
BROWSERBASE_KEEP_ALIVE=false

# Remote browser launch settings. Timed settling does not confirm CAPTCHA completion.
BROWSERBASE_PROXIES=false
BROWSERBASE_SOLVE_CAPTCHAS=true
BROWSERBASE_CAPTCHA_SETTLE_MS=10000
BROWSERBASE_VERIFIED=true
BROWSERBASE_PROXY_COUNTRY=US
BROWSERBASE_PROXY_STATE=
BROWSERBASE_PROXY_CITY=
BROWSERBASE_OS=

# all | hillsborough | lee | miwayne
SITE=all

# Safe demo defaults. Replace only with authorized criteria.
SEARCH_FIRST_NAME=John
SEARCH_LAST_NAME=Smith
LEE_FIRST_NAME_FALLBACK=Jo*
SEARCH_LOOKBACK_DAYS=365
# Optional overrides. If unset, the runner uses the last SEARCH_LOOKBACK_DAYS days.
SEARCH_FROM_DATE=
SEARCH_TO_DATE=

# Save aggregate-only private reports by default.
REDACT_OUTPUT=true
