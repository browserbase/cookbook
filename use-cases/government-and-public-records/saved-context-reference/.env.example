# ── Browserbase (required) ────────────────────────────────────────────────────
# `probe` needs ONLY these two — no credentials, no Context.
BROWSERBASE_API_KEY=

# ── Context (set after `npm run setup` prints one) ─────────────────────────────
# Leave blank for `probe` and the first `setup`. `verify` and `search` require it.
BROWSERBASE_CONTEXT_ID=

# ── Model (Browserbase managed gateway — no provider key needed) ───────────────
# Any gateway-supported id. Swap to anthropic/claude-sonnet-4-6 for a Claude run.
MODEL=google/gemini-3-flash-preview

# ── Verified / network posture (defaults match the operator case) ───────────────
# Texas exit IP via residential proxy + macOS fingerprint + Verified.
BB_REGION=us-east-1
PROXY_COUNTRY=US
PROXY_STATE=TX          # blank to disable a state-pinned exit IP
OS_FINGERPRINT=mac      # windows | mac | linux  (mac satisfies Akamai + Cloudflare)

# ── Tunables (optional) ────────────────────────────────────────────────────────
# SETTLE_MS=8000                 # wait after nav for the SPA / anti-bot sensor to settle
# NAV_TIMEOUT_MS=60000
# SETUP_SESSION_TIMEOUT_S=1800   # how long `setup` keeps the session alive for manual login
