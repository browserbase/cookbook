# Browserbase — required for cloud browser sessions
# Get these from https://browserbase.com/overview
BROWSERBASE_API_KEY=

# OpenAI — used by Stagehand for act() and extract() AI calls
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google — used for Gemini models (faster agent performance)
# Get this from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# (Optional) Anthropic — alternative model provider
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
