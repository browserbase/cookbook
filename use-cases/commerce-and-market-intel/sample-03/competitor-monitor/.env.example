# Browserbase credentials (https://www.browserbase.com/settings)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# No LLM provider key is needed for Process 2 (URL monitoring): the high-volume
# capture path is pure Browserbase + Playwright network interception — no model
# calls in the hot loop.
#
# Process 1 (category deep-dive crawl, phase 2) uses Stagehand act/observe/extract.
# Those route through Browserbase's managed Model Gateway by default (no provider
# key required). To bypass the gateway and use a provider directly, set a key here,
# e.g.:
# GOOGLE_GENERATIVE_AI_API_KEY=
