# Copy to .env and fill in.
#
# The simplest working setup is a single Browserbase key: Stagehand's
# act/observe/extract calls then run on the Browserbase Model Gateway, and you
# never configure an LLM provider at all.

BROWSERBASE_API_KEY=

# --- Optional: bring your own model for act/observe/extract ---------------
# Leave RETAILER_DEMO_MODEL_NAME unset to use the Browserbase Model Gateway.
# Set it to a "provider/model" name to pin one, and supply that provider's key.
# Required when RETAILER_DEMO_BROWSER=local -- the gateway needs a Browserbase session.
# RETAILER_DEMO_MODEL_NAME=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# RETAILER_DEMO_MODEL_NAME=openai/gpt-5.4-mini
# OPENAI_API_KEY=sk-...
# RETAILER_DEMO_MODEL_NAME=google/gemini-2.5-flash
# GOOGLE_API_KEY=...

# --- The model that drives the agent loop --------------------------------
# Separate from the one above on purpose: your loop model and your
# page-understanding model do not have to match. Claude Agent SDK
# authenticates with ANTHROPIC_API_KEY, or an existing Claude Code login.
# RETAILER_DEMO_CLAUDE_MODEL=claude-sonnet-5

# --- Run shape ------------------------------------------------------------
# tools = Claude picks Stagehand tools one at a time (direct tool calls).
# code  = Claude writes Stagehand scripts that run inside the browser extension.
RETAILER_DEMO_MODE=tools

# browserbase | local. Defaults to browserbase when BROWSERBASE_API_KEY is set.
# RETAILER_DEMO_BROWSER=browserbase

# Point the demo at your own environment instead of the bundled shelf.
# RETAILER_DEMO_URL=https://your-internal-host/shelf

# Run the local browser headless. Set automatically in CI.
# STAGEHAND_HEADLESS=1

# Narration pacing for demo recordings.
# RETAILER_DEMO_STEP_DELAY_MS=1800
# RETAILER_DEMO_ACTION_DELAY_MS=900
