# Your Browserbase API key (from https://www.browserbase.com/settings).
# This is the only credential the server needs. No project id required: the key scopes your org.
BROWSERBASE_API_KEY=

# The page the embedded browser opens on. Defaults to Square, matching the demo repo.
# Point this at whatever account your customer is connecting (Square, Vagaro, etc.).
START_URL=https://squareup.com/us/en

# Port for the local server.
PORT=3000

# Written automatically after a successful login. In your own app, store this id
# wherever you keep per-user state (your database) instead of a file.
# CONTEXT_ID=
