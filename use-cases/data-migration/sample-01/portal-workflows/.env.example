# Browserbase — required. Find your key at https://www.browserbase.com/settings
# (Project ID is no longer needed — the API key scopes the org.)
BROWSERBASE_API_KEY=

# Model key for workflow runs — set the one matching the default model (see src/config.ts).
# Default model is anthropic/claude-haiku-4-5-20251001, so set the Anthropic key:
ANTHROPIC_API_KEY=
# (Or GOOGLE_GENERATIVE_AI_API_KEY / OPENAI_API_KEY if you switch the model's provider.)
GOOGLE_GENERATIVE_AI_API_KEY=

# Per-site Browserbase contexts — set automatically by `npm run customer-login:<platform>`.
# Each site has its own context so their auth never collides. Do not edit by hand.
SQUARE_CONTEXT_ID=
VAGARO_CONTEXT_ID=
# Legacy single-context var; still honored as a fallback for Square if SQUARE_CONTEXT_ID is unset.
CONTEXT_ID=
