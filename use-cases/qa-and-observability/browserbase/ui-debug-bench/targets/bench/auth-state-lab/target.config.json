{
  "name": "auth-state-lab",
  "app": "app",
  "install": "bun install --frozen-lockfile",
  "serve": "bun run dev --host 127.0.0.1 --port {port}",
  "validate": [
    "bun run build"
  ],
  "fixerContext": [
    "src/routes/",
    "src/app/pages/",
    "src/app/",
    "src/components/app-layout",
    "src/",
    "src/components/ui/"
  ],
  "hosted": {
    "auth-guard": "https://btc-auth-state-lab.example.invalid/auth-guard",
    "auth-logout": "https://btc-auth-state-lab.example.invalid/auth-logout",
    "state-theme-reset": "https://btc-auth-state-lab.example.invalid/state-theme-reset"
  }
}