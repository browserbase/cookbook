# Required: debugger + fixer agents
ANTHROPIC_API_KEY=

# Optional: model override (default claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Optional: --browserbase mode (cloud sessions with replays)
# BROWSERBASE_API_KEY=

# Optional: browse CLI target mode (local | cdp-launch | cdp | remote)
# BROWSE_TARGET=local
