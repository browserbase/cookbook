# ============================================================
# Browserbase Benchmark — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---------------------------
# Always required
# ---------------------------

# Browserbase credentials — used by the browserbase competitor.
# Get these from https://browserbase.com/settings
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=us-west-2       # Optional. Default: us-west-2

# Sites to benchmark — comma-separated URLs.
BENCHMARK_SITES=https://chatgpt.com,https://espn.com,https://amazon.com

# ---------------------------
# LLM for Stagehand (AI steps)
# Required for any scenario step that calls stagehand.act() or stagehand.extract().
# Not needed if running with --browser-only.
# ---------------------------

# Default model: Google Gemini 2.5 Flash.
# Get an API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# To switch to a different provider, set BENCHMARK_MODEL and the corresponding key:
#
#   Anthropic Claude:
#     BENCHMARK_MODEL=anthropic/claude-opus-4-5
#     ANTHROPIC_API_KEY=          # Stagehand reads this automatically for anthropic/* models
#
#   OpenAI:
#     BENCHMARK_MODEL=openai/gpt-4o
#     OPENAI_API_KEY=             # Stagehand reads this automatically for openai/* models
#
# The default is google/gemini-2.5-flash (via GOOGLE_API_KEY).
BENCHMARK_MODEL=google/gemini-2.5-flash

# ---------------------------
# Competitor-specific keys
# Only set the keys for competitors you're running.
# ---------------------------

# DIY Chromium on a cloud VM (EC2, Render, Fly.io, etc.)
# Set to the CDP WebSocket URL your Chromium process exposes.
# Used by: any custom WebSocket competitor you add in src/competitors/
# RENDER_CHROMIUM_WS_URL=ws://your-chromium-service.onrender.com

# Chromium in a sandboxed compute environment (serverless, containers, etc.)
# Set to whatever CDP WebSocket URL your sandbox exposes.
# SANDBOX_CHROMIUM_WS_URL=ws://...

# ---------------------------
# Deployment
# ---------------------------

# Render — used by npm run run:render
RENDER_SERVICE_URL=                # e.g. https://bb-benchmark-xxxx.onrender.com

# AWS — required only for EC2 provisioning (npm run run:ec2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# ---------------------------
# Tuning (optional)
# ---------------------------

# Number of benchmark runs per site × scenario × competitor. Default: 5
BENCHMARK_RUNS=5

# Path to a local Chrome/Chromium binary.
# Auto-detected if blank (checks common macOS/Linux paths + Playwright bundle).
LOCAL_CHROMIUM_EXECUTABLE=

# Playwright browser cache path — set this on Render to persist across deploys.
PLAYWRIGHT_BROWSERS_PATH=

# Cost analysis inputs — used to generate the cost comparison section in report.html.
SESSIONS_PER_DAY=500              # How many browser sessions you run per day
AVG_SESSION_MINUTES=3             # Average duration of each session in minutes

# Required for the HTTP dashboard/API and Render launcher (64 hex characters).
BENCHMARK_ACCESS_TOKEN=
# Exact origin of the HTTP server, e.g. https://your-service.onrender.com
BENCHMARK_PUBLIC_ORIGIN=http://localhost:3000
