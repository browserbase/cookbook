# ── Browserbase ──────────────────────────────────────────────────────────────
# Required to run anything. The "reach the login page + classify the wall"
# diagnostic needs ONLY these two — no site credentials required.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional: reuse a persistent Browserbase Context (cookies + fingerprint) across
# runs. Leave blank to get a fresh context each session. The trial customer had a
# Context attached, so set this to reproduce that exactly.
BROWSERBASE_CONTEXT_ID=

# No LLM provider key needed — Stagehand's default API mode routes act/extract
# through Browserbase's managed model gateway, which handles model auth server-side.

# ── Site credentials (PLACEHOLDERS — fill in when Sample Organization provides them) ──────
# The harness only attempts a real login when BOTH the username and password for
# a site are set to a non-empty, non-placeholder value. Until then it just reaches
# each login page and reports what bot wall (if any) it lands on.
#
# Leave these blank (or as the <...> placeholders) to run detection-only.

OPENTABLE_USERNAME=
OPENTABLE_PASSWORD=

SITEDISH_USERNAME=
SITEDISH_PASSWORD=

AESTHETICRECORD_USERNAME=
AESTHETICRECORD_PASSWORD=

FEDEX_USERNAME=
FEDEX_PASSWORD=
