# Copy to .env and fill in. .env is gitignored.

# Browserbase (https://browserbase.com — Settings)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=...

# Momentic (https://momentic.ai — used by the CLI; the shim forwards this through
# to api.momentic.ai for everything except the browser-connection call)
MOMENTIC_API_KEY=
