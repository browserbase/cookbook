# Browserbase (required)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# OpenAI — Whisper transcription for the voice notes in the record→fix demo (optional)
OPENAI_API_KEY=
# (browser-trace/eval also auto-prefer GROQ_API_KEY for Whisper if set)
# GROQ_API_KEY=

# Path to the browser-trace skill's scripts dir (impact + eval demos).
# Install from https://www.skills.sh/browserbase/skills/browser-trace
# BROWSER_TRACE_DIR=/absolute/path/to/skills/browser-trace/scripts
