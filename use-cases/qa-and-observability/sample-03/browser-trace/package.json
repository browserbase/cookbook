{
  "name": "app_builder-browser-trace",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Record→fix diagnostic bundle + a runtime-error eval showing browser-trace (CDP firehose on Browserbase) vs local Playwright.",
  "scripts": {
    "demo": "node --env-file=.env record-and-fix/server.mjs",
    "impact": "node --env-file=.env runtime-demo/capture-trace.mjs",
    "impact:inline": "node --env-file=.env runtime-demo/capture.mjs",
    "eval": "node --env-file=.env eval/run-eval.mjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@browserbasehq/sdk": "2.19.0",
    "playwright-core": "1.62.1"
  }
}
