# ─── Browserbase (required for cloud execution) ─────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# ─── Outer browser agent (required, OpenAI via AI SDK) ──────────────
OPENAI_API_KEY=
# Bare model ID only; do not use an openai/ prefix.
# AGENT_MODEL=gpt-5.4-mini

# ─── Stagehand primitive model (separate configuration) ─────────────
# Default primitive: anthropic/claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
# MODEL_NAME=anthropic/claude-sonnet-4-20250514
# MODEL_NAME=google/<supported-model-id>
# GOOGLE_API_KEY=your_google_api_key
# MODEL_NAME=openai/gpt-5.4-mini
# The openai/ primitive reuses OPENAI_API_KEY; outer agent still needs it.
# Optional explicit primitive key override. Leave this commented when using
# the provider-specific key; an explicitly blank override is rejected.
# MODEL_API_KEY=your_primitive_api_key

# Optional Travel portal flow tuning.
# TRAVEL_PORTAL_AGENT_WAIT_MS=1500
# TRAVEL_PORTAL_AGENT_SCREENSHOTS=false
# TRAVEL_PORTAL_INITIAL_READY_TIMEOUT_MS=30000
# TRAVEL_PORTAL_APP_READY_TIMEOUT_MS=120000
# TRAVEL_PORTAL_APP_RELOAD_READY_TIMEOUT_MS=90000
# TRAVEL_PORTAL_EMAIL_TRANSITION_TIMEOUT_MS=90000
# TRAVEL_PORTAL_PASSWORD_TRANSITION_TIMEOUT_MS=120000
# TRAVEL_PORTAL_SEARCH_SUBMIT_TIMEOUT_MS=90000
# TRAVEL_PORTAL_RESULTS_TIMEOUT_MS=180000
# TRAVEL_PORTAL_SESSION_TIMEOUT_SECONDS=900

# ─── Travel portal Login (for authenticated Travel portal benchmark) ────────────────
TRAVEL_PORTAL_EMAIL=your_travel_portal_email
TRAVEL_PORTAL_PASSWORD=
# Created by: npm run demo -- --setup-travel-portal-context
# Or pass once via: npm run demo -- --single --only-travel portal --travel-portal-context-id=ctx_...
TRAVEL_PORTAL_CONTEXT_ID=

# ─── Mock Site URL (defaults to localhost:3000) ──────────────────────
# MOCK_BASE_URL=http://localhost:3000

# ─── Real Airline URLs (for production use) ──────────────────────────
# When ready to go live, replace mock URLs with real airline sites:
# UNITED_URL=https://www.united.com/en/us/book-flight/results
# DELTA_URL=https://www.delta.com/flight-search/results
# AA_URL=https://www.aa.com/booking/find-flights
# GOOGLE_FLIGHTS_URL=https://www.google.com/travel/flights
# EXPEDIA_URL=https://www.expedia.com/Flights
