# Copy to .env and fill in.
ANTHROPIC_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Persisted context created by ./bootstrap-context.sh — leave blank, the
# script will append it.
BROWSERBASE_CONTEXT_ID=

# bizfile credentials. Filled in once and reused. The actual login happens
# inside the BB live-view session during bootstrap; these env vars are
# referenced by task.md so the agent doesn't have to be told the password
# in plaintext inside the brief.
BIZFILE_USER=
BIZFILE_PASS=

# ─── LLC formation parameters ──────────────────────────────────────────
# Real identity used on the legal filing. Every field below is required;
# the Playwright script throws on startup if any value is blank.

# LLC name as it will be filed with the CA Secretary of State.
LLC_NAME=

# Principal business address (the LLC's main office).
LLC_PRINCIPAL_STREET=
LLC_PRINCIPAL_CITY=
LLC_PRINCIPAL_STATE=
LLC_PRINCIPAL_ZIP=

# Mailing address. Often the same as principal — duplicate the values if so.
LLC_MAILING_STREET=
LLC_MAILING_CITY=
LLC_MAILING_STATE=
LLC_MAILING_ZIP=

# Agent for Service of Process (individual, not a corporation). For a
# California-formed LLC, the agent MUST have a California street address.
LLC_AGENT_FIRST_NAME=
LLC_AGENT_LAST_NAME=
LLC_AGENT_STREET=
LLC_AGENT_CITY=
LLC_AGENT_STATE=
LLC_AGENT_ZIP=

# Management structure — one of "all members", "one manager", "more than one manager".
LLC_MANAGEMENT_STRUCTURE="all members"

# Organizer name — also used as the typed electronic signature on Step 9.
# Must be a real person with intent to organize the LLC.
LLC_ORGANIZER_NAME=

# Explicit opt-in for the payment-handoff path. Keep false for dry setup,
# context bootstrap, and code checks. Set true only when a human is watching
# the live view and intends to review the populated payment screen.
BIZFILE_ALLOW_PAYMENT_HANDOFF=false

# ─── Credit-card payment (post-Step-11 payment screen) ─────────────────
# Required only when BIZFILE_ALLOW_PAYMENT_HANDOFF=true. The script populates
# the payment form and STOPS before the final payment-submit button — nothing
# is charged until a human clicks that button.
PAYMENT_CARD_NUMBER=
PAYMENT_CARDHOLDER_NAME=
PAYMENT_CARD_EXP_MONTH=
PAYMENT_CARD_EXP_YEAR=
PAYMENT_CARD_CVV=
PAYMENT_BILLING_ADDRESS=
PAYMENT_BILLING_CITY=
PAYMENT_BILLING_STATE=
PAYMENT_BILLING_ZIP=
