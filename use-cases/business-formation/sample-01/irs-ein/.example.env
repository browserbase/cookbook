# Copy to .env and fill in local secrets.
ANTHROPIC_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Responsible party — the IRS runs a real-time TIN/name match on these.
# Mock defaults below will be rejected by the IRS at the Identity step
# (proves the agent can navigate the form; replace with real values to
# advance to Addresses and beyond).
EIN_RESPONSIBLE_SSN=900123456
EIN_RESPONSIBLE_FIRST_NAME=Jamie
EIN_RESPONSIBLE_MIDDLE_NAME=
EIN_RESPONSIBLE_LAST_NAME=Rivera

# Business inputs.
EIN_BUSINESS_NAME="Browserbase Demo LLC"
EIN_TRADE_NAME=
EIN_ADDRESS_LINE1="123 Market Street"
EIN_CITY="San Francisco"
EIN_STATE=CA
EIN_ZIP=94105
EIN_COUNTY="San Francisco"
EIN_PHONE=415-555-0198
