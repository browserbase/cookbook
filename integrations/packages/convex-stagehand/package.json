{
  "name": "@browserbasehq/convex-stagehand",
  "version": "0.1.1",
  "description": "Convex component for AI-powered browser automation with Stagehand",
  "type": "module",
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "build:esm": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build:esm",
    "build:clean": "rm -rf dist && npm run build:codegen",
    "dev": "npm-run-all --parallel 'dev:*'",
    "dev:backend": "npx convex dev --typecheck-components",
    "dev:build": "chokidar 'src/**/*.ts' --initial -c 'npm run build:codegen'",
    "typecheck": "tsc --noEmit && cd example && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck"
  },
  "keywords": [
    "convex",
    "component",
    "stagehand",
    "browserbase",
    "browser-automation",
    "ai",
    "web-scraping"
  ],
  "author": "Browserbase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/browserbase/integrations.git",
    "directory": "packages/convex-stagehand"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@browserbasehq/sdk": "2.21.0",
    "ai": "7.0.118",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/google": "4.0.82"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "chokidar-cli": "^3.0.0",
    "convex": "1.46.0",
    "convex-test": "0.0.60",
    "eslint": "^10.11.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  },
  "overrides": {
    "zod": "4.6.5"
  }
}
