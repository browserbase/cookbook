{
  "name": "@browserbasehq/openclaw-browserbase",
  "version": "0.1.2",
  "description": "OpenClaw plugin for cloud browser automation with anti-bot stealth, CAPTCHA solving, and residential proxies via Browserbase",
  "packageManager": "pnpm@10.21.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "types",
    "openclaw.plugin.json"
  ],
  "keywords": [
    "openclaw",
    "plugin",
    "browserbase",
    "browser",
    "automation",
    "web-scraping",
    "captcha",
    "anti-bot",
    "stealth",
    "proxy",
    "headless-browser",
    "ai-agent"
  ],
  "author": "Browserbase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/browserbase/integrations.git",
    "directory": "packages/openclaw-browserbase"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.29"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "tar": "^7.5.9",
    "json5": "2.2.3"
  }
}
