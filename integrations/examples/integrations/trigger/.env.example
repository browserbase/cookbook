# Trigger.dev Configuration
TRIGGER_SECRET_KEY=

# Browserbase Configuration (for web scraping)
BROWSERBASE_API_KEY=

# Cloudflare R2 Storage Configuration (for file uploads)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=your-r2-bucket-name
# Public HTTPS base serving this bucket; never the R2 S3 API endpoint.
S3_PUBLIC_BASE_URL=

# OpenAI Configuration (for AI summarization)
OPENAI_API_KEY=

# Resend Configuration (for email delivery)
RESEND_API_KEY=
HN_EMAIL_FROM=
HN_EMAIL_TO=
