{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./lib",
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mjs"
  ]
}
