# auto uses Browserbase when BROWSERBASE_API_KEY is set. The local form fixture stays local.
STAGEHAND_BROWSER=auto

# Set this for Browserbase sessions on public websites.
BROWSERBASE_API_KEY=

# Optional Browserbase Context. Browsie uses it when STAGEHAND_BROWSER=browserbase.
BROWSERBASE_CONTEXT_ID=

# Eve calls the OpenAI Responses API directly.
OPENAI_API_KEY=
BROWSIE_MODEL=gpt-5.6-sol

# Linq iMessage and SMS channel. Register /eve/v1/linq as the webhook path.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Optional comma-separated Linq message author IDs. Empty accepts every sender.
BROWSIE_LINQ_ALLOWED_USER_IDS=
# Public HTTPS app origin used for browser handoff links.
BROWSIE_PUBLIC_URL=
# At least 32 characters. Signs short-lived browser handoff links.
BROWSIE_HANDOFF_SECRET=

# Native Vault demo: 32 random bytes encoded as base64, or 64 hex characters.
BROWSIE_VAULT_MASTER_KEY=
# Local demo only; deployments must use durable storage plus KMS.
BROWSIE_VAULT_FILE=.browsie/vault.enc.json

# 1Password hosted mode (server-only) and optional local desktop mode.
OP_SERVICE_ACCOUNT_TOKEN=
OP_ACCOUNT=

# Stripe Link Agent Wallet. Create this outside Browsie and keep it server-side.
# Browsie uses it for wallet tools and approved one-time payment credentials.
LINK_ACCESS_TOKEN=

BROWSIE_HEADLESS=true

# Close a browser runtime after this much tool inactivity. Default: 30 minutes.
BROWSIE_BROWSER_IDLE_MS=1800000
